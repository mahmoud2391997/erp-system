# JWT Secret for authentication tokens
# Generate a secure random string using: openssl rand -base64 32
# JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database URL - Supabase PostgreSQL connection string
# Format: postgresql://postgres:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"

# Direct URL for migrations (use port 5432 without pgbouncer)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?schema=public"

# Node Environment
NODE_ENV="production"

# Next.js Public API URL (leave empty for same-origin requests)
# NEXT_PUBLIC_API_URL=""
